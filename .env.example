# Site (public)
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_URL=

# Shopify Storefront API — SERVER ONLY (NEXT_PUBLIC_ kullanmayın)
# Domain örn: your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Public Storefront access token
# Header: X-Shopify-Storefront-Access-Token
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Opsiyonel: Private Storefront token (server-only)
# Header: Shopify-Storefront-Private-Token
# Public token yoksa bunu kullanın
# SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

SHOPIFY_STOREFRONT_API_VERSION=2025-01

# true = DEMO mock data | false = gerçek Shopify (API hata verirse demo'ya düşmez)
USE_MOCK_DATA=true

# Homepage vitrin collection handle'ları (boş = section gizli)
# Discovery sonrası doldurun: npm run shopify:discover
SHOPIFY_COLLECTION_FEATURED=
SHOPIFY_COLLECTION_BEST_SELLERS=
